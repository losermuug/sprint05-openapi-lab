{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run lint && npm run build:docs",
  "outputDirectory": "public",
  "functions": {
    "api/lab.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/lab?lab_path=/health"
    },
    {
      "source": "/sandbox/prometheus/:path*",
      "destination": "/api/lab?lab_path=/sandbox/prometheus/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/lab?lab_path=/v1/:path*"
    }
  ]
}
